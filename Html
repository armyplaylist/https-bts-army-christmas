  :root{
    --bg:#0A0620;
    --bg2:#170A2E;
    --surface:rgba(20,8,42,.78);
  }
}

*{
  box-sizing:border-box
}

html,body,#root{
  margin:0;
  min-height:100%;
  background:var(--bg);
  color:var(--ink)
}

body{
  font-family:Outfit,system-ui,-apple-system,Segoe UI,sans-serif;
  overflow-x:clip
}

.font-serif{
  font-family:"Playfair Display",Georgia,serif
}

button,input,textarea,select{
  font:inherit
}

button{
  cursor:pointer
}

a{
  color:inherit
}

.glass{
  background:var(--surface);
  backdrop-filter:blur(18px);
  border:1px solid var(--line);
  box-shadow:0 20px 60px rgba(0,0,0,.38)
}

.pill{
  border:1px solid var(--line);
  border-radius:999px;
  padding:10px 15px;
  background:rgba(10,6,32,.66);
  backdrop-filter:blur(14px);
  color:#fff;
  display:inline-flex;
  align-items:center;
  gap:8px;
  font-weight:700
}

.pill:hover,.btn-primary:hover{
  box-shadow:0 0 0 1px #A78BFA,0 0 28px rgba(167,139,250,.55);
  transform:translateY(-1px)
}

.btn-primary{
  background:linear-gradient(135deg,#A78BFA,#6D28D9 58%,#F59E0B 150%);
  border:1px solid #C4B5FD;
  border-radius:999px;
  padding:12px 20px;
  color:white;
  font-weight:800;
  box-shadow:0 10px 30px rgba(109,40,217,.45)
}

.btn-ghost{
  border:1px solid var(--line);
  border-radius:999px;
  padding:11px 16px;
  background:rgba(255,255,255,.06);
  color:#fff;
  font-weight:700
}

.field{
  width:100%;
  background:rgba(255,255,255,.07);
  border:1px solid var(--line);
  border-radius:12px;
  padding:11px 12px;
  color:white;
  outline:none
}

.field:focus{
  border-color:#A78BFA;
  box-shadow:0 0 0 3px rgba(167,139,250,.2)
}

label{
  font-size:12px;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:#C4B5FD;
  font-weight:800
}

.chip{
  border:1px solid var(--line);
  border-radius:999px;
  padding:7px 10px;
  background:rgba(255,255,255,.05);
  font-size:13px
}

.chip.active{
  background:#A78BFA;
  color:#1A0B2E;
  border-color:white;
  font-weight:800
}

.glow-title{
  text-shadow:0 0 18px rgba(167,139,250,.9),0 0 48px rgba(167,139,250,.45),0 3px 0 rgba(255,255,255,.08)
}

@keyframes floaty{
  0%,100%{
    transform:translateY(0)
  }

  50%{
    transform:translateY(-9px)
  }
}

@keyframes twinkle{
  0%,100%{
    opacity:.25;
    transform:scale(.75)
  }

  50%{
    opacity:1;
    transform:scale(1.15)
  }
}

@keyframes snowfall{
  to{
    transform:translateY(108vh) translateX(18px)
  }
}

@keyframes doorGlow{
  0%,100%{
    box-shadow:0 0 30px rgba(167,139,250,.35)
  }

  50%{
    box-shadow:0 0 70px rgba(233,213,255,.75)
  }
}

@keyframes burst{
  0%{
    transform:scale(.2);
    opacity:1
  }

  100%{
    transform:scale(2.2) translate(var(--bx),var(--by));
    opacity:0
  }
}

@keyframes rise{
  from{
    opacity:0;
    transform:translateY(18px)
  }

  to{
    opacity:1;
    transform:translateY(0)
  }
}

.rise{
  animation:rise .55s ease both
}

.door-wrap{
  perspective:1400px
}

.door-panel{
  transition:transform 1.2s cubic-bezier(.2,.8,.2,1),opacity 1.2s;
  transform-origin:left center;
  animation:doorGlow 2.6s infinite
}

.door-panel.right{
  transform-origin:right center
}

.door-open .door-panel.left{
  transform:rotateY(-78deg) translateX(-24px)
}

.door-open .door-panel.right{
  transform:rotateY(78deg) translateX(24px)
}

.door-open .door-core{
  opacity:0
}

.no-scrollbar::-webkit-scrollbar{
  display:none
}

.no-scrollbar{
  scrollbar-width:none
}

